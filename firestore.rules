rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function hasOnly(keys) {
      return request.resource.data.keys().hasOnly(keys);
    }

    function validSlug(slug) {
      return slug is string
        && slug.size() >= 3
        && slug.size() <= 60
        && slug.matches('^[a-z0-9]+(-[a-z0-9]+)*$');
    }

    function validText(value, min, max) {
      return value is string
        && value.size() >= min
        && value.size() <= max;
    }

    function validOptionalText(value, max) {
      return value is string
        && value.size() <= max;
    }

    function validOptionalUrl(url) {
      return url is string
        && url.size() <= 500
        && (url.size() == 0 || url.matches('^https?://.{1,490}$'));
    }

    function validPhone(phone) {
      return phone is string
        && phone.size() >= 10
        && phone.size() <= 20;
    }

    function validPlan(plan) {
      return plan in ['trial', 'starter', 'studio', 'pro'];
    }

    function validSubscriptionStatus(status) {
      return status in ['trialing', 'active', 'past_due', 'cancelled'];
    }

    function validAccountStatus(status) {
      return status in ['trial_expired', 'past_due', 'cancelled'];
    }

    function validDateString(date) {
      return date is string
        && date.matches('^\\d{4}-\\d{2}-\\d{2}$');
    }

    function validTimeString(time) {
      return time is string
        && time.matches('^([01]\\d|2[0-3]):[0-5]\\d$');
    }

    function validBusinessHours(hours) {
      return hours is map
        && hours.keys().hasOnly(['start', 'end', 'slotInterval'])
        && validTimeString(hours.start)
        && validTimeString(hours.end)
        && hours.start < hours.end
        && hours.slotInterval in [15, 30, 45, 60];
    }

    function validBlockedDates(dates) {
      return dates is list
        && dates.size() <= 120;
    }

    function validCompleteProfile(profileData) {
      return profileData.profileComplete == false
        || (
          ('barbershopName' in profileData)
          && validText(profileData.barbershopName, 2, 80)
          && ('phone' in profileData)
          && validPhone(profileData.phone)
          && ('businessHours' in profileData)
          && validBusinessHours(profileData.businessHours)
        );
    }

    function validArchiveFields() {
      return (!('isArchived' in request.resource.data) || request.resource.data.isArchived is bool)
        && (!('archivedAt' in request.resource.data) || request.resource.data.archivedAt is timestamp)
        && (!('archivedAt' in request.resource.data) || request.resource.data.isArchived == true);
    }

    function validClientSnapshot(client) {
      return client is map
        && client.keys().hasOnly(['id', 'name', 'phone', 'phoneNormalized', 'createdAt', 'updatedAt', 'userId', 'barberSlug'])
        && client.id is string
        && validText(client.name, 2, 80)
        && client.phone is string
        && client.phone.size() >= 10
        && client.phone.size() <= 13
        && (!('phoneNormalized' in client) || client.phoneNormalized == client.phone)
        && (!('userId' in client) || client.userId is string)
        && (!('barberSlug' in client) || client.barberSlug is string);
    }

    function validServiceSnapshot(serviceData) {
      return serviceData is map
        && serviceData.keys().hasOnly(['id', 'name', 'price', 'duration', 'createdAt', 'updatedAt', 'userId'])
        && serviceData.id is string
        && validText(serviceData.name, 2, 80)
        && serviceData.price is number
        && serviceData.price >= 0
        && serviceData.price <= 100000
        && validServiceDuration(serviceData.duration)
        && (!('userId' in serviceData) || serviceData.userId is string);
    }

    function appointmentSnapshotsMatchFields() {
      return request.resource.data.client.id == request.resource.data.clientId
        && request.resource.data.client.name == request.resource.data.clientName
        && request.resource.data.client.phone == request.resource.data.clientPhone
        && request.resource.data['service'].duration == request.resource.data.duration
        && (!('userId' in request.resource.data.client) || request.resource.data.client.userId == request.resource.data.userId)
        && (!('userId' in request.resource.data['service']) || request.resource.data['service'].userId == request.resource.data.userId);
    }

    function validServiceDuration(durationValue) {
      return durationValue in [15, 30, 45, 60, 75, 90, 105, 120, 135, 150, 165, 180, 195, 210, 225, 240];
    }

    function validAppointmentTiming() {
      return validServiceDuration(request.resource.data.duration)
        && request.resource.data.startMinutes is number
        && request.resource.data.endMinutes is number
        && request.resource.data.startMinutes >= 0
        && request.resource.data.startMinutes < 1440
        && request.resource.data.endMinutes > request.resource.data.startMinutes
        && request.resource.data.endMinutes == request.resource.data.startMinutes + request.resource.data.duration
        && request.resource.data.endMinutes <= 1440;
    }

    function validBookingSlotTiming() {
      return validServiceDuration(request.resource.data.duration)
        && request.resource.data.startMinutes is number
        && request.resource.data.endMinutes is number
        && request.resource.data.startMinutes >= 0
        && request.resource.data.startMinutes < 1440
        && request.resource.data.endMinutes > request.resource.data.startMinutes
        && request.resource.data.endMinutes == request.resource.data.startMinutes + request.resource.data.duration
        && request.resource.data.endMinutes <= 1440;
    }

    function matchesPublicProfile(userId, slug) {
      return userId is string
        && slug is string
        && exists(/databases/$(database)/documents/publicProfiles/$(userId))
        && get(/databases/$(database)/documents/publicProfiles/$(userId)).data.slug == slug
        && get(/databases/$(database)/documents/publicProfiles/$(userId)).data.profileComplete == true
        && hasActivePublicAccount(userId);
    }

    function hasCompletePublicProfile(userId) {
      return userId is string
        && exists(/databases/$(database)/documents/publicProfiles/$(userId))
        && get(/databases/$(database)/documents/publicProfiles/$(userId)).data.profileComplete == true
        && hasActivePublicAccount(userId);
    }

    function hasActivePublicAccount(userId) {
      return exists(/databases/$(database)/documents/users/$(userId))
        && (
          (
            get(/databases/$(database)/documents/users/$(userId)).data.subscriptionStatus == 'active'
            && (
              !('subscriptionEndsAt' in get(/databases/$(database)/documents/users/$(userId)).data)
              || get(/databases/$(database)/documents/users/$(userId)).data.subscriptionEndsAt > request.time
            )
          )
          || (
            get(/databases/$(database)/documents/users/$(userId)).data.subscriptionStatus == 'trialing'
            && (
              !('trialEndsAt' in get(/databases/$(database)/documents/users/$(userId)).data)
              || get(/databases/$(database)/documents/users/$(userId)).data.trialEndsAt > request.time
            )
          )
        );
    }

    function publicBillingMatchesUser(profileId) {
      return exists(/databases/$(database)/documents/users/$(profileId))
        && request.resource.data.plan == get(/databases/$(database)/documents/users/$(profileId)).data.plan
        && request.resource.data.subscriptionStatus == get(/databases/$(database)/documents/users/$(profileId)).data.subscriptionStatus
        && (
          (!('trialEndsAt' in request.resource.data) && !('trialEndsAt' in get(/databases/$(database)/documents/users/$(profileId)).data))
          || (('trialEndsAt' in get(/databases/$(database)/documents/users/$(profileId)).data) && request.resource.data.trialEndsAt == get(/databases/$(database)/documents/users/$(profileId)).data.trialEndsAt)
        )
        && (
          (!('subscriptionEndsAt' in request.resource.data) && !('subscriptionEndsAt' in get(/databases/$(database)/documents/users/$(profileId)).data))
          || (('subscriptionEndsAt' in get(/databases/$(database)/documents/users/$(profileId)).data) && request.resource.data.subscriptionEndsAt == get(/databases/$(database)/documents/users/$(profileId)).data.subscriptionEndsAt)
        )
        && (
          (!('billingUpdatedAt' in request.resource.data) && !('billingUpdatedAt' in get(/databases/$(database)/documents/users/$(profileId)).data))
          || (('billingUpdatedAt' in get(/databases/$(database)/documents/users/$(profileId)).data) && request.resource.data.billingUpdatedAt == get(/databases/$(database)/documents/users/$(profileId)).data.billingUpdatedAt)
        );
    }

    function renewalRequestMatchesAccount(userId) {
      return exists(/databases/$(database)/documents/users/$(userId))
        && request.resource.data.plan == get(/databases/$(database)/documents/users/$(userId)).data.plan
        && (
          (
            request.resource.data.accountStatus in ['past_due', 'cancelled']
            && request.resource.data.accountStatus == get(/databases/$(database)/documents/users/$(userId)).data.subscriptionStatus
          )
          || (
            request.resource.data.accountStatus == 'trial_expired'
            && get(/databases/$(database)/documents/users/$(userId)).data.subscriptionStatus == 'trialing'
            && ('trialEndsAt' in get(/databases/$(database)/documents/users/$(userId)).data)
            && get(/databases/$(database)/documents/users/$(userId)).data.trialEndsAt <= request.time
          )
        );
    }

    function clientPhoneKeyMatchesClient() {
      return existsAfter(/databases/$(database)/documents/clients/$(request.resource.data.clientId))
        && getAfter(/databases/$(database)/documents/clients/$(request.resource.data.clientId)).data.userId == request.resource.data.userId
        && getAfter(/databases/$(database)/documents/clients/$(request.resource.data.clientId)).data.phoneNormalized == request.resource.data.phoneNormalized
        && getAfter(/databases/$(database)/documents/clients/$(request.resource.data.clientId)).data.isArchived == false;
    }

    function clientPhoneKeyIdForClient() {
      return request.resource.data.userId + '_' + request.resource.data.phoneNormalized;
    }

    function activeClientHasPhoneKey(clientId) {
      return request.resource.data.isArchived == false
        && existsAfter(/databases/$(database)/documents/clientPhoneKeys/$(clientPhoneKeyIdForClient()))
        && getAfter(/databases/$(database)/documents/clientPhoneKeys/$(clientPhoneKeyIdForClient())).data.clientId == clientId
        && getAfter(/databases/$(database)/documents/clientPhoneKeys/$(clientPhoneKeyIdForClient())).data.userId == request.resource.data.userId
        && getAfter(/databases/$(database)/documents/clientPhoneKeys/$(clientPhoneKeyIdForClient())).data.phoneNormalized == request.resource.data.phoneNormalized;
    }

    function appointmentUsesActiveClient() {
      return existsAfter(/databases/$(database)/documents/clients/$(request.resource.data.clientId))
        && getAfter(/databases/$(database)/documents/clients/$(request.resource.data.clientId)).data.userId == request.resource.data.userId
        && getAfter(/databases/$(database)/documents/clients/$(request.resource.data.clientId)).data.phoneNormalized == request.resource.data.clientPhone
        && getAfter(/databases/$(database)/documents/clients/$(request.resource.data.clientId)).data.isArchived == false;
    }

    function archivedClientReleasesPhoneKey() {
      return request.resource.data.isArchived == true
        && !existsAfter(/databases/$(database)/documents/clientPhoneKeys/$(clientPhoneKeyIdForClient()));
    }

    function isPublishedOperationalResource() {
      return (!('isArchived' in resource.data) || resource.data.isArchived == false)
        && !('archivedAt' in resource.data);
    }

    function appointmentUsesPublishedService(serviceId) {
      return serviceId is string
        && exists(/databases/$(database)/documents/services/$(serviceId))
        && get(/databases/$(database)/documents/services/$(serviceId)).data.userId == request.resource.data.userId
        && get(/databases/$(database)/documents/services/$(serviceId)).data.isArchived == false
        && !('archivedAt' in get(/databases/$(database)/documents/services/$(serviceId)).data)
        && get(/databases/$(database)/documents/services/$(serviceId)).data.name == request.resource.data['service'].name
        && get(/databases/$(database)/documents/services/$(serviceId)).data.price == request.resource.data['service'].price
        && get(/databases/$(database)/documents/services/$(serviceId)).data.duration == request.resource.data.duration;
    }

    function appointmentUsesPublishedBarber(barberId) {
      return barberId is string
        && exists(/databases/$(database)/documents/barbers/$(barberId))
        && get(/databases/$(database)/documents/barbers/$(barberId)).data.ownerId == request.resource.data.userId
        && get(/databases/$(database)/documents/barbers/$(barberId)).data.isArchived == false
        && !('archivedAt' in get(/databases/$(database)/documents/barbers/$(barberId)).data)
        && get(/databases/$(database)/documents/barbers/$(barberId)).data.name == request.resource.data.barberName;
    }

    function publicUserFields() {
      return [
        'email',
        'slug',
        'displayName',
        'barbershopName',
        'phone',
        'bio',
        'logoUrl',
        'avatar',
        'businessHours',
        'blockedDates',
        'profileComplete',
        'plan',
        'subscriptionStatus',
        'subscriptionEndsAt',
        'billingUpdatedAt',
        'trialEndsAt',
        'createdAt',
        'updatedAt'
      ];
    }

    function validAuditAction(action) {
      return action in [
        'client_created',
        'client_updated',
        'client_archived',
        'client_restored',
        'service_created',
        'service_updated',
        'service_archived',
        'service_restored',
        'barber_created',
        'barber_updated',
        'barber_archived',
        'barber_restored',
        'appointment_created',
        'appointment_updated',
        'appointment_status_updated'
      ];
    }

    function slugKeyWillBelongTo(slug, userId) {
      return existsAfter(/databases/$(database)/documents/publicSlugKeys/$(slug))
        && getAfter(/databases/$(database)/documents/publicSlugKeys/$(slug)).data.uid == userId;
    }

    function validAuditEntity(entityType) {
      return entityType in ['client', 'service', 'barber', 'appointment'];
    }

    function appointmentFields() {
      return [
        'id',
        'clientId',
        'client',
        'clientName',
        'clientPhone',
        'service',
        'barberId',
        'barberName',
        'date',
        'time',
        'duration',
        'startMinutes',
        'endMinutes',
        'status',
        'userId',
        'barberSlug',
        'slotId',
        'slotIds',
        'privacyConsent',
        'privacyConsentVersion',
        'privacyConsentAt',
        'createdAt',
        'updatedAt'
      ];
    }

    function appointmentRootSlotMatches(appointmentId) {
      return existsAfter(/databases/$(database)/documents/bookingSlots/$(request.resource.data.slotId))
        && getAfter(/databases/$(database)/documents/bookingSlots/$(request.resource.data.slotId)).data.appointmentId == appointmentId
        && getAfter(/databases/$(database)/documents/bookingSlots/$(request.resource.data.slotId)).data.userId == request.resource.data.userId
        && getAfter(/databases/$(database)/documents/bookingSlots/$(request.resource.data.slotId)).data.barberId == request.resource.data.barberId
        && getAfter(/databases/$(database)/documents/bookingSlots/$(request.resource.data.slotId)).data.date == request.resource.data.date
        && getAfter(/databases/$(database)/documents/bookingSlots/$(request.resource.data.slotId)).data.time == request.resource.data.time
        && getAfter(/databases/$(database)/documents/bookingSlots/$(request.resource.data.slotId)).data.rootTime == request.resource.data.time
        && getAfter(/databases/$(database)/documents/bookingSlots/$(request.resource.data.slotId)).data.startMinutes == request.resource.data.startMinutes
        && getAfter(/databases/$(database)/documents/bookingSlots/$(request.resource.data.slotId)).data.endMinutes == request.resource.data.endMinutes
        && getAfter(/databases/$(database)/documents/bookingSlots/$(request.resource.data.slotId)).data.duration == request.resource.data.duration
        && getAfter(/databases/$(database)/documents/bookingSlots/$(request.resource.data.slotId)).data.status == request.resource.data.status;
    }

    function cancelledAppointmentReleasesRootSlot() {
      return request.resource.data.status == 'cancelled'
        && !existsAfter(/databases/$(database)/documents/bookingSlots/$(request.resource.data.slotId));
    }

    function bookingSlotMatchesAppointment(slotId) {
      return existsAfter(/databases/$(database)/documents/appointments/$(request.resource.data.appointmentId))
        && slotId in getAfter(/databases/$(database)/documents/appointments/$(request.resource.data.appointmentId)).data.slotIds
        && getAfter(/databases/$(database)/documents/appointments/$(request.resource.data.appointmentId)).data.userId == request.resource.data.userId
        && getAfter(/databases/$(database)/documents/appointments/$(request.resource.data.appointmentId)).data.barberId == request.resource.data.barberId
        && getAfter(/databases/$(database)/documents/appointments/$(request.resource.data.appointmentId)).data.barberName == request.resource.data.barberName
        && getAfter(/databases/$(database)/documents/appointments/$(request.resource.data.appointmentId)).data.date == request.resource.data.date
        && getAfter(/databases/$(database)/documents/appointments/$(request.resource.data.appointmentId)).data.time == request.resource.data.rootTime
        && getAfter(/databases/$(database)/documents/appointments/$(request.resource.data.appointmentId)).data.duration == request.resource.data.duration
        && getAfter(/databases/$(database)/documents/appointments/$(request.resource.data.appointmentId)).data.startMinutes == request.resource.data.startMinutes
        && getAfter(/databases/$(database)/documents/appointments/$(request.resource.data.appointmentId)).data.endMinutes == request.resource.data.endMinutes
        && getAfter(/databases/$(database)/documents/appointments/$(request.resource.data.appointmentId)).data.status == request.resource.data.status;
    }

    function bookingSlotReleasedByAppointment(slotId) {
      return existsAfter(/databases/$(database)/documents/appointments/$(resource.data.appointmentId))
        && getAfter(/databases/$(database)/documents/appointments/$(resource.data.appointmentId)).data.userId == resource.data.userId
        && (
          getAfter(/databases/$(database)/documents/appointments/$(resource.data.appointmentId)).data.status == 'cancelled'
          || !(slotId in getAfter(/databases/$(database)/documents/appointments/$(resource.data.appointmentId)).data.slotIds)
        );
    }

    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isOwner(userId)
        && hasOnly([
          'email',
          'slug',
          'displayName',
          'plan',
          'subscriptionStatus',
          'profileComplete',
          'trialEndsAt',
          'createdAt'
        ])
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.email is string
        && validSlug(request.resource.data.slug)
        && validText(request.resource.data.displayName, 2, 80)
        && validPlan(request.resource.data.plan)
        && validSubscriptionStatus(request.resource.data.subscriptionStatus)
        && request.resource.data.plan == 'trial'
        && request.resource.data.subscriptionStatus == 'trialing'
        && request.resource.data.profileComplete == false
        && request.resource.data.trialEndsAt is timestamp
        && slugKeyWillBelongTo(request.resource.data.slug, userId);
      allow update: if isOwner(userId)
        && hasOnly(publicUserFields())
        && request.resource.data.email == resource.data.email
        && validSlug(request.resource.data.slug)
        && validText(request.resource.data.displayName, 2, 80)
        && (!('barbershopName' in request.resource.data) || validText(request.resource.data.barbershopName, 2, 80))
        && (!('phone' in request.resource.data) || validPhone(request.resource.data.phone))
        && (!('bio' in request.resource.data) || validOptionalText(request.resource.data.bio, 500))
        && (!('logoUrl' in request.resource.data) || validOptionalUrl(request.resource.data.logoUrl))
        && (!('avatar' in request.resource.data) || validOptionalUrl(request.resource.data.avatar))
        && (!('businessHours' in request.resource.data) || validBusinessHours(request.resource.data.businessHours))
        && (!('blockedDates' in request.resource.data) || validBlockedDates(request.resource.data.blockedDates))
        && request.resource.data.profileComplete is bool
        && validCompleteProfile(request.resource.data)
        && request.resource.data.updatedAt is timestamp
        && (!('createdAt' in resource.data) || request.resource.data.createdAt == resource.data.createdAt)
        && request.resource.data.plan == resource.data.plan
        && request.resource.data.subscriptionStatus == resource.data.subscriptionStatus
        && (
          (!('trialEndsAt' in request.resource.data) && !('trialEndsAt' in resource.data))
          || (('trialEndsAt' in resource.data) && request.resource.data.trialEndsAt == resource.data.trialEndsAt)
        )
        && (
          (!('subscriptionEndsAt' in request.resource.data) && !('subscriptionEndsAt' in resource.data))
          || (('subscriptionEndsAt' in resource.data) && request.resource.data.subscriptionEndsAt == resource.data.subscriptionEndsAt)
        )
        && (
          (!('billingUpdatedAt' in request.resource.data) && !('billingUpdatedAt' in resource.data))
          || (('billingUpdatedAt' in resource.data) && request.resource.data.billingUpdatedAt == resource.data.billingUpdatedAt)
        )
        && slugKeyWillBelongTo(request.resource.data.slug, userId);
      allow delete: if false;
    }

    match /publicSlugKeys/{slugId} {
      allow get: if signedIn();
      allow list: if false;
      allow create, update: if signedIn()
        && hasOnly(['uid', 'slug', 'createdAt', 'updatedAt'])
        && slugId == request.resource.data.slug
        && request.resource.data.uid == request.auth.uid
        && validSlug(slugId)
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp
        && (!exists(/databases/$(database)/documents/publicSlugKeys/$(slugId)) || resource.data.uid == request.auth.uid);
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    match /publicProfiles/{profileId} {
      allow get: if isOwner(profileId)
        || (
          resource.data.profileComplete == true
          && hasActivePublicAccount(profileId)
        );
      allow list: if request.query.limit <= 1
        && resource.data.profileComplete == true
        && hasActivePublicAccount(profileId);
      allow create, update: if isOwner(profileId)
        && hasOnly([
          'slug',
          'displayName',
          'barbershopName',
          'phone',
          'bio',
          'logoUrl',
          'avatar',
          'businessHours',
          'blockedDates',
          'profileComplete',
          'plan',
          'subscriptionStatus',
          'subscriptionEndsAt',
          'billingUpdatedAt',
          'trialEndsAt',
          'updatedAt'
        ])
        && validSlug(request.resource.data.slug)
        && validText(request.resource.data.displayName, 2, 80)
        && request.resource.data.profileComplete is bool
        && validCompleteProfile(request.resource.data)
        && request.resource.data.updatedAt is timestamp
        && validPlan(request.resource.data.plan)
        && validSubscriptionStatus(request.resource.data.subscriptionStatus)
        && publicBillingMatchesUser(profileId)
        && (!('barbershopName' in request.resource.data) || validText(request.resource.data.barbershopName, 2, 80))
        && (!('phone' in request.resource.data) || validPhone(request.resource.data.phone))
        && (!('bio' in request.resource.data) || validOptionalText(request.resource.data.bio, 500))
        && (!('logoUrl' in request.resource.data) || validOptionalUrl(request.resource.data.logoUrl))
        && (!('avatar' in request.resource.data) || validOptionalUrl(request.resource.data.avatar))
        && (!('businessHours' in request.resource.data) || validBusinessHours(request.resource.data.businessHours))
        && (!('blockedDates' in request.resource.data) || validBlockedDates(request.resource.data.blockedDates))
        && slugKeyWillBelongTo(request.resource.data.slug, profileId);
      allow delete: if false;
    }

    match /clients/{clientId} {
      allow get: if isOwner(resource.data.userId);
      allow list: if isOwner(resource.data.userId) && request.query.limit <= 1000;
      allow create: if hasOnly(['name', 'phone', 'phoneNormalized', 'createdAt', 'userId', 'barberSlug', 'isArchived'])
        && (
          isOwner(request.resource.data.userId)
          || matchesPublicProfile(request.resource.data.userId, request.resource.data.barberSlug)
        )
        && request.resource.data.userId is string
        && request.resource.data.name is string
        && request.resource.data.phone is string
        && request.resource.data.phoneNormalized is string
        && request.resource.data.phone == request.resource.data.phoneNormalized
        && request.resource.data.name.size() >= 2
        && request.resource.data.name.size() <= 80
        && request.resource.data.phone.size() >= 10
        && request.resource.data.phone.size() <= 13
        && request.resource.data.createdAt is timestamp
        && request.resource.data.isArchived == false
        && activeClientHasPhoneKey(clientId);
      allow update: if isOwner(resource.data.userId)
        && hasOnly(['name', 'phone', 'phoneNormalized', 'createdAt', 'updatedAt', 'userId', 'barberSlug', 'isArchived', 'archivedAt'])
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt is timestamp
        && request.resource.data.name is string
        && request.resource.data.phone is string
        && request.resource.data.phoneNormalized is string
        && request.resource.data.phone == request.resource.data.phoneNormalized
        && request.resource.data.name.size() >= 2
        && request.resource.data.name.size() <= 80
        && request.resource.data.phone.size() >= 10
        && request.resource.data.phone.size() <= 13
        && validArchiveFields()
        && (
          activeClientHasPhoneKey(clientId)
          || archivedClientReleasesPhoneKey()
        );
      allow delete: if false;
    }

    match /clientPhoneKeys/{phoneKeyId} {
      allow get: if !exists(/databases/$(database)/documents/clientPhoneKeys/$(phoneKeyId))
        || isOwner(resource.data.userId)
        || hasCompletePublicProfile(resource.data.userId)
        || matchesPublicProfile(resource.data.userId, resource.data.barberSlug);
      allow list: if false;
      allow create: if hasOnly(['userId', 'phoneNormalized', 'clientId', 'barberSlug', 'createdAt'])
        && phoneKeyId == request.resource.data.userId + '_' + request.resource.data.phoneNormalized
        && (
          isOwner(request.resource.data.userId)
          || matchesPublicProfile(request.resource.data.userId, request.resource.data.barberSlug)
        )
        && request.resource.data.userId is string
        && request.resource.data.phoneNormalized is string
        && request.resource.data.clientId is string
        && request.resource.data.phoneNormalized.size() >= 10
        && request.resource.data.phoneNormalized.size() <= 13
        && request.resource.data.createdAt is timestamp
        && clientPhoneKeyMatchesClient();
      allow update: if false;
      allow delete: if isOwner(resource.data.userId);
    }

    match /services/{serviceId} {
      allow get: if isOwner(resource.data.userId) || (hasCompletePublicProfile(resource.data.userId) && isPublishedOperationalResource());
      allow list: if (
          isOwner(resource.data.userId) && request.query.limit <= 300
        ) || (
          hasCompletePublicProfile(resource.data.userId) && isPublishedOperationalResource() && request.query.limit <= 100
        );
      allow create: if hasOnly(['name', 'price', 'duration', 'createdAt', 'updatedAt', 'userId', 'isArchived'])
        && isOwner(request.resource.data.userId)
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2
        && request.resource.data.name.size() <= 80
        && request.resource.data.price is number
        && request.resource.data.price >= 0
        && request.resource.data.price <= 100000
        && validServiceDuration(request.resource.data.duration)
        && request.resource.data.createdAt is timestamp
        && (!('updatedAt' in request.resource.data) || request.resource.data.updatedAt is timestamp)
        && request.resource.data.isArchived == false;
      allow update: if isOwner(resource.data.userId)
        && hasOnly(['name', 'price', 'duration', 'createdAt', 'updatedAt', 'userId', 'isArchived', 'archivedAt'])
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt is timestamp
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2
        && request.resource.data.name.size() <= 80
        && request.resource.data.price is number
        && request.resource.data.price >= 0
        && request.resource.data.price <= 100000
        && validServiceDuration(request.resource.data.duration)
        && validArchiveFields();
      allow delete: if false;
    }

    match /barbers/{barberId} {
      allow get: if isOwner(resource.data.ownerId) || (hasCompletePublicProfile(resource.data.ownerId) && isPublishedOperationalResource());
      allow list: if (
          isOwner(resource.data.ownerId) && request.query.limit <= 100
        ) || (
          hasCompletePublicProfile(resource.data.ownerId) && isPublishedOperationalResource() && request.query.limit <= 50
        );
      allow create: if hasOnly(['name', 'specialty', 'avatar', 'ownerId', 'createdAt', 'updatedAt', 'isArchived'])
        && isOwner(request.resource.data.ownerId)
        && validText(request.resource.data.name, 2, 80)
        && (!('specialty' in request.resource.data) || validOptionalText(request.resource.data.specialty, 80))
        && (!('avatar' in request.resource.data) || validOptionalUrl(request.resource.data.avatar))
        && request.resource.data.createdAt is timestamp
        && (!('updatedAt' in request.resource.data) || request.resource.data.updatedAt is timestamp)
        && request.resource.data.isArchived == false;
      allow update: if isOwner(resource.data.ownerId)
        && hasOnly(['name', 'specialty', 'avatar', 'ownerId', 'createdAt', 'updatedAt', 'isArchived', 'archivedAt'])
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt is timestamp
        && validText(request.resource.data.name, 2, 80)
        && (!('specialty' in request.resource.data) || validOptionalText(request.resource.data.specialty, 80))
        && (!('avatar' in request.resource.data) || validOptionalUrl(request.resource.data.avatar))
        && validArchiveFields();
      allow delete: if false;
    }

    match /appointments/{appointmentId} {
      allow get: if isOwner(resource.data.userId);
      allow list: if isOwner(resource.data.userId) && request.query.limit <= 2000;
      allow create: if (
          isOwner(request.resource.data.userId)
          || (
            matchesPublicProfile(request.resource.data.userId, request.resource.data.barberSlug)
            && getAfter(/databases/$(database)/documents/bookingSlots/$(request.resource.data.slotId)).data.appointmentId == appointmentId
            && request.resource.data.privacyConsent == true
            && request.resource.data.privacyConsentVersion is string
            && request.resource.data.privacyConsentVersion.size() >= 10
            && request.resource.data.privacyConsentVersion.size() <= 40
            && request.resource.data.privacyConsentAt is timestamp
          )
        )
        && hasOnly(appointmentFields())
        && request.resource.data.userId is string
        && (!('id' in request.resource.data) || request.resource.data.id == appointmentId)
        && validText(request.resource.data.clientName, 2, 80)
        && request.resource.data.clientPhone is string
        && request.resource.data.clientPhone.size() >= 10
        && request.resource.data.clientPhone.size() <= 13
        && validClientSnapshot(request.resource.data.client)
        && appointmentUsesActiveClient()
        && validServiceSnapshot(request.resource.data['service'])
        && appointmentUsesPublishedService(request.resource.data['service'].id)
        && appointmentSnapshotsMatchFields()
        && request.resource.data.barberId is string
        && validText(request.resource.data.barberName, 2, 80)
        && appointmentUsesPublishedBarber(request.resource.data.barberId)
        && validDateString(request.resource.data.date)
        && validTimeString(request.resource.data.time)
        && request.resource.data.slotId is string
        && request.resource.data.slotIds is list
        && request.resource.data.slotIds.size() >= 1
        && request.resource.data.slotIds.size() <= 16
        && request.resource.data.slotIds[0] == request.resource.data.slotId
        && validAppointmentTiming()
        && appointmentRootSlotMatches(appointmentId)
        && request.resource.data.status == 'pending';
      allow update: if isOwner(resource.data.userId)
        && resource.data.status in ['pending', 'confirmed']
        && hasOnly(appointmentFields())
        && request.resource.data.userId == resource.data.userId
        && (!('id' in request.resource.data) || request.resource.data.id == appointmentId)
        && request.resource.data.status in ['pending', 'confirmed', 'completed', 'cancelled']
        && validText(request.resource.data.clientName, 2, 80)
        && request.resource.data.clientPhone is string
        && request.resource.data.clientPhone.size() >= 10
        && request.resource.data.clientPhone.size() <= 13
        && validClientSnapshot(request.resource.data.client)
        && validServiceSnapshot(request.resource.data['service'])
        && appointmentUsesPublishedService(request.resource.data['service'].id)
        && appointmentSnapshotsMatchFields()
        && validText(request.resource.data.barberName, 2, 80)
        && appointmentUsesPublishedBarber(request.resource.data.barberId)
        && validDateString(request.resource.data.date)
        && validTimeString(request.resource.data.time)
        && request.resource.data.slotId is string
        && request.resource.data.slotIds is list
        && request.resource.data.slotIds.size() >= 1
        && request.resource.data.slotIds.size() <= 16
        && request.resource.data.slotIds[0] == request.resource.data.slotId
        && validAppointmentTiming()
        && (
          cancelledAppointmentReleasesRootSlot()
          || appointmentRootSlotMatches(appointmentId)
        );
      allow delete: if false;
    }

    match /bookingSlots/{slotId} {
      allow get: if isOwner(resource.data.userId) || hasCompletePublicProfile(resource.data.userId);
      allow list: if (
          isOwner(resource.data.userId) || hasCompletePublicProfile(resource.data.userId)
        ) && request.query.limit <= 200;
      allow create: if hasOnly([
          'appointmentId',
          'userId',
          'barberId',
          'barberName',
          'date',
          'time',
          'rootTime',
          'duration',
          'startMinutes',
          'endMinutes',
          'status',
          'createdAt',
          'updatedAt'
        ])
        && request.resource.data.userId is string
        && (
          isOwner(request.resource.data.userId)
          || (
            existsAfter(/databases/$(database)/documents/appointments/$(request.resource.data.appointmentId))
            && getAfter(/databases/$(database)/documents/appointments/$(request.resource.data.appointmentId)).data.barberSlug
            == get(/databases/$(database)/documents/publicProfiles/$(request.resource.data.userId)).data.slug
          )
        )
        && request.resource.data.appointmentId is string
        && request.resource.data.barberId is string
        && validText(request.resource.data.barberName, 2, 80)
        && validDateString(request.resource.data.date)
        && validTimeString(request.resource.data.time)
        && validTimeString(request.resource.data.rootTime)
        && bookingSlotMatchesAppointment(slotId)
        && validBookingSlotTiming()
        && request.resource.data.createdAt is timestamp
        && (!('updatedAt' in request.resource.data) || request.resource.data.updatedAt is timestamp)
        && request.resource.data.status in ['pending', 'confirmed'];
      allow update: if isOwner(resource.data.userId)
        && hasOnly([
          'appointmentId',
          'userId',
          'barberId',
          'barberName',
          'date',
          'time',
          'rootTime',
          'duration',
          'startMinutes',
          'endMinutes',
          'status',
          'createdAt',
          'updatedAt'
        ])
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.appointmentId == resource.data.appointmentId
        && (!('createdAt' in resource.data) || request.resource.data.createdAt == resource.data.createdAt)
        && request.resource.data.updatedAt is timestamp
        && validText(request.resource.data.barberName, 2, 80)
        && validDateString(request.resource.data.date)
        && validTimeString(request.resource.data.time)
        && validTimeString(request.resource.data.rootTime)
        && validBookingSlotTiming()
        && request.resource.data.status in ['pending', 'confirmed', 'completed', 'cancelled']
        && (
          (
            request.resource.data.barberId == resource.data.barberId
            && request.resource.data.date == resource.data.date
            && request.resource.data.time == resource.data.time
            && request.resource.data.rootTime == resource.data.rootTime
            && request.resource.data.duration == resource.data.duration
            && request.resource.data.startMinutes == resource.data.startMinutes
            && request.resource.data.endMinutes == resource.data.endMinutes
          )
          || bookingSlotMatchesAppointment(slotId)
        );
      allow delete: if isOwner(resource.data.userId)
        && bookingSlotReleasedByAppointment(slotId);
    }

    match /auditLogs/{auditLogId} {
      allow get: if isOwner(resource.data.userId);
      allow list: if isOwner(resource.data.userId) && request.query.limit <= 100;
      allow create: if isOwner(request.resource.data.userId)
        && hasOnly([
          'userId',
          'actorId',
          'action',
          'entityType',
          'entityId',
          'entityLabel',
          'summary',
          'source',
          'createdAt'
        ])
        && request.resource.data.actorId == request.auth.uid
        && validAuditAction(request.resource.data.action)
        && validAuditEntity(request.resource.data.entityType)
        && validText(request.resource.data.entityId, 1, 128)
        && validOptionalText(request.resource.data.entityLabel, 120)
        && validOptionalText(request.resource.data.summary, 160)
        && validOptionalText(request.resource.data.source, 40)
        && request.resource.data.createdAt is timestamp;
      allow update, delete: if false;
    }

    match /renewalRequests/{requestId} {
      allow create: if hasOnly(['userId', 'barbershopName', 'accountStatus', 'plan', 'requestedPlan', 'timestamp', 'status', 'createdAt'])
        && requestId == request.auth.uid
        && isOwner(request.resource.data.userId)
        && request.resource.data.status == 'pending'
        && validText(request.resource.data.barbershopName, 2, 80)
        && validAccountStatus(request.resource.data.accountStatus)
        && renewalRequestMatchesAccount(request.resource.data.userId)
        && validPlan(request.resource.data.plan)
        && validPlan(request.resource.data.requestedPlan)
        && request.resource.data.timestamp is timestamp
        && request.resource.data.createdAt is timestamp;
      allow read, update, delete: if false;
    }
  }
}
