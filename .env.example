# Firebase Configuration
# Get these values from your Firebase project settings
VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id
VITE_FIREBASE_APPCHECK_RECAPTCHA_SITE_KEY=

# Optional support contact for trial renewal. Use country code and digits only.
VITE_SUPPORT_WHATSAPP=
VITE_AUTH_ACTION_URL=

# Optional client-side diagnostics. Keep disabled unless you provide a safe endpoint.
VITE_ENABLE_CLIENT_LOGS=false
VITE_TELEMETRY_ENDPOINT=
